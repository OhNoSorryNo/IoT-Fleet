<+>import docker\r\nimport uvicorn\r\nfrom docker.errors import NotFound, APIError\r\nfrom fastapi import FastAPI, HTTPException\r\nfrom pydantic import BaseModel\r\nimport blinker\r\nfrom flask import Flask, request\r\nfrom gpiozero import LED\r\n\r\n# LED-Setup\r\ngreen_led = LED(17)  # Grün: Heartbeat successful\r\nred_led = LED(27)    # Red: Heartbeat unsuccessful\r\nblue_led = LED(22)   # Blue: Device updating\r\n\r\napp = Flask(__name__)\r\n\r\n@app.route('/led', methods=['POST'])\r\ndef control_led():\r\n    data = request.json\r\n    status = data.get(\"status\")\r\n\r\n    green_led.off()\r\n    red_led.off()\r\n    blue_led.off()\r\n\r\n    # Status check and LED control\r\n    if status == \"online\":\r\n        green_led.on()\r\n    elif status == \"offline\":\r\n        red_led.on()\r\n    elif status == \"updating\":\r\n        blue_led.on()\r\n    elif status == \"registration\":\r\n        blue_led.blink()\r\n        red_led.blink()\r\n    elif status == \"successful\":\r\n        green_led.blink()\r\n    elif status == \"unsuccessful\":\r\n        red_led.blink()\r\n    else:\r\n        return \"Invalid status\", 400\r\n\r\n    return \"LED status updated\", 200\r\n\r\nif __name__ == '__main__':\r\n    app.run(host='0.0.0.0', port=6060)\r\n
