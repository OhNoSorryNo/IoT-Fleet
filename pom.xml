<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.springframework.boot</groupId>
    <artifactId>myproject-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>Server</module>
        <module>Device/Communicator</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.3.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.3.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.10</version>
                <executions>

                    <!-- (1) Merge execution -->
                    <execution>
                        <id>merge</id>
                        <inherited>false</inherited>
                        <phase>none</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/merged-jacoco.exec</destFile>
                            <fileSets>
                                <!-- Make sure these point to your actual submodule targets -->
                                <fileSet>
                                    <directory>${basedir}/Server/target</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                    </includes>
                                </fileSet>
                                <fileSet>
                                    <directory>${basedir}/Device/Communicator/target</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>

                    <!-- (2) report-aggregate execution -->
                    <execution>
                        <id>aggregate-report</id>
                        <inherited>false</inherited>
                        <!-- You can use phase="verify" or "none", if you only call it manually -->
                        <phase>none</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <!-- The merged JaCoCo file from the 'merge' step -->
                            <dataFile>${project.build.directory}/merged-jacoco.exec</dataFile>

                            <!-- Where the combined HTML/XML coverage goes -->
                            <outputDirectory>${project.build.directory}/merged-report</outputDirectory>

                            <!-- Because 'report-aggregate' auto-detects submodules,
                                 you do *not* specify <classDirectories> here. -->
                        </configuration>
                    </execution>

                </executions>
            </plugin>
        </plugins>
    </build>
</project>
